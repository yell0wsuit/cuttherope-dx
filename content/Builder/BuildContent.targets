<Project>
  <PropertyGroup>
    <ContentBuilderProject>$(MSBuildThisFileDirectory)CutTheRopeDX.Content.csproj</ContentBuilderProject>
    <ContentSourceDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</ContentSourceDir>

    <!--
      The same directory, without the trailing separator, for passing on a command line. On
      Windows a quoted path that ends in a backslash escapes the closing quote, so the argument
      arrives with a stray quote in it and the builder rejects it as an illegal path. The two
      forms are kept apart because MakeRelative below wants the separator that breaks Exec.
    -->
    <ContentSourcePath>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..'))</ContentSourcePath>
    <ContentIntermediateDir>$(MSBuildThisFileDirectory)obj/content</ContentIntermediateDir>
    <ContentFileList>$(ContentIntermediateDir)/content_files.txt</ContentFileList>

    <!--
      Whether this build works out what to ship. Jobs handed a prepared source tree and file list
      set this false, which is why the condition sits on the tasks rather than on the target: the
      deploy below still has to run.
    -->
    <BuildContent Condition="'$(BuildContent)' == ''">true</BuildContent>

    <!--
      Whether this build carries a copy of the content to its output. Normally it must: a build has
      to be runnable on its own. The Windows release is the exception, where two backends are
      published into one directory and share a single copy, so the second is told to skip the
      deploy. That saves copying roughly 340MB of it twice, once into the build output and again
      into the publish directory, only to delete it while assembling the package.
    -->
    <DeployContent Condition="'$(DeployContent)' == ''">true</DeployContent>

    <!--
      The builder is a plain framework-dependent tool, whatever the game is being published as.
      RuntimeIdentifier alone is not enough to strip: a publish passes _IsPublishing, and with
      PublishAot, PublishReadyToRun or PublishSingleFile beside it the SDK infers the host RID on
      its own. Only global properties can be removed this way, though. Environment variables still
      reach the builder and can move its output (a machine-wide Platform variable, common on OEM
      Windows installs, puts it under bin/<platform>/), so the builder is run from the path its own
      build reports rather than from a fixed one.
    -->
    <_ContentBuilderRemovedProperties>Configuration;TargetFramework;RuntimeIdentifier;RuntimeIdentifiers;SelfContained;UseCurrentRuntimeIdentifier;PublishSingleFile;PublishAot;PublishReadyToRun;PublishTrimmed;_IsPublishing</_ContentBuilderRemovedProperties>
  </PropertyGroup>

  <!--
    Split into steps so the one running is the one named while the build waits: the terminal
    logger shows only the current target and hides the builder's output, and a first build spends
    minutes in FetchGameAssets downloading the assets.
  -->
  <Target Name="BuildContentBuilder">
    <MSBuild Projects="$(ContentBuilderProject)" Targets="Restore"
             Condition="'$(BuildContent)' == 'true'"
             RemoveProperties="$(_ContentBuilderRemovedProperties)" />
    <MSBuild Projects="$(ContentBuilderProject)" Targets="Build"
             Condition="'$(BuildContent)' == 'true'"
             RemoveProperties="$(_ContentBuilderRemovedProperties)">
      <Output TaskParameter="TargetOutputs" PropertyName="_ContentBuilderAssembly" />
    </MSBuild>
    <Error Condition="'$(BuildContent)' == 'true' AND !Exists('$(_ContentBuilderAssembly)')"
           Text="The content builder was built, but no assembly was found at '$(_ContentBuilderAssembly)'." />
  </Target>

  <!--
    The builder reports its own failures as build errors. The exit code is taken here so the
    build ends on a sentence about which step failed rather than on MSB3073, which only
    repeats the command line.
  -->
  <Target Name="FetchGameAssets" DependsOnTargets="BuildContentBuilder">
    <Exec Condition="'$(BuildContent)' == 'true'"
          Command="dotnet &quot;$(_ContentBuilderAssembly)&quot; fetch -s &quot;$(ContentSourcePath)&quot;"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_ContentFetchExitCode" />
    </Exec>
    <Error Condition="'$(BuildContent)' == 'true' AND '$(_ContentFetchExitCode)' != '0'"
           Text="Could not get the game assets into '$(ContentSourcePath)'. The content builder's error above says why." />
  </Target>

  <Target Name="BuildGameContent" BeforeTargets="BeforeBuild" DependsOnTargets="FetchGameAssets">
    <Exec Condition="'$(BuildContent)' == 'true'"
          Command="dotnet &quot;$(_ContentBuilderAssembly)&quot; build -s &quot;$(ContentSourcePath)&quot; -o &quot;$(ContentIntermediateDir)&quot;"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_ContentBuildExitCode" />
    </Exec>
    <Error Condition="'$(BuildContent)' == 'true' AND '$(_ContentBuildExitCode)' != '0'"
           Text="Could not work out which game content to ship from '$(ContentSourcePath)'. The content builder's error above says why." />
  </Target>

  <!--
    The assets are deployed from where they already are. They need no conversion, so staging them
    into a build directory first would copy roughly 340MB to no end and leave a second tree to keep
    in step. The builder decides which files those are; this reads that answer and lets MSBuild do
    what it already does well.
  -->
  <Target Name="CollectGameContent" AfterTargets="BuildGameContent"
          Condition="Exists('$(ContentFileList)') AND '$(DeployContent)' == 'true'">
    <ReadLinesFromFile File="$(ContentFileList)">
      <Output TaskParameter="Lines" ItemName="_GameContentFile" />
    </ReadLinesFromFile>
    <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-macos'">
      <None Include="@(_GameContentFile)">
        <Link>content/$([MSBuild]::MakeRelative('$(ContentSourceDir)', '%(FullPath)'))</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>

      <!-- The one file the build generates. It has no source path to derive a link from. -->
      <None Include="$(ContentIntermediateDir)/images/image_dimensions.json">
        <Link>content/images/image_dimensions.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
    </ItemGroup>
  </Target>

  <!--
    macOS: the .app bundle takes the same assets, but as BundleResource.
    _CollectBundleResources runs outside the normal BeforeBuild ordering, so items
    added by CollectGameContent never reach it. The Apple SDK's documented extension
    point is CollectBundleResourcesDependsOn; the SDK prepends its own targets to
    whatever this property already holds, so setting it here survives.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-macos'">
    <CollectBundleResourcesDependsOn>
      $(CollectBundleResourcesDependsOn);
      AddMacOSBundleContent;
    </CollectBundleResourcesDependsOn>
  </PropertyGroup>

  <Target Name="AddMacOSBundleContent" DependsOnTargets="BuildGameContent"
          Condition="'$(TargetFramework)' == 'net10.0-macos' AND '$(DeployContent)' == 'true' AND Exists('$(ContentFileList)')">
    <ReadLinesFromFile File="$(ContentFileList)">
      <Output TaskParameter="Lines" ItemName="_MacContentFile" />
    </ReadLinesFromFile>
    <ItemGroup>
      <BundleResource Include="@(_MacContentFile)">
        <Link>content/$([MSBuild]::MakeRelative('$(ContentSourceDir)', '%(FullPath)'))</Link>
      </BundleResource>
      <BundleResource Include="$(ContentIntermediateDir)/images/image_dimensions.json">
        <Link>content/images/image_dimensions.json</Link>
      </BundleResource>
    </ItemGroup>
  </Target>
</Project>
