<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!--
    Desktop-facing tests: these exercise the host's own composition - video output, the FFmpeg
    library resolver, and the update checker - which CutTheRopeDX.Tests cannot reach because it
    references Core only. Core comes in transitively through Desktop's own ProjectReference.
  -->
  <ItemGroup>
    <ProjectReference Include="..\CutTheRopeDX.Desktop\CutTheRopeDX.Desktop.csproj" />
  </ItemGroup>

  <!--
    The reference above also hands over Desktop's deployed content tree, 350MB these tests never
    open: they exercise quad batching, blend state, song looping and font targets, none of which
    load an asset. Dropping it keeps the test output the size of the assemblies under test.
  -->
  <Target Name="ExcludeGameContentFromTestOutput" BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory">
    <ItemGroup>
      <_SourceItemsToCopyToOutputDirectory Remove="@(_SourceItemsToCopyToOutputDirectory)"
                                           Condition="$([System.String]::Copy('%(_SourceItemsToCopyToOutputDirectory.TargetPath)').StartsWith('content'))" />
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_SourceItemsToCopyToOutputDirectoryAlways)"
                                                 Condition="$([System.String]::Copy('%(_SourceItemsToCopyToOutputDirectoryAlways.TargetPath)').StartsWith('content'))" />
    </ItemGroup>
  </Target>

</Project>
