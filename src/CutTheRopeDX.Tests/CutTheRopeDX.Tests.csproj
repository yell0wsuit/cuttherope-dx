<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!--
    Mirrors the constant the game project defines, so a test that depends on which MonoGame is behind it
    can say so at compile time. Deriving that from the framework at run time instead would mean a test
    detecting the absence of the very thing it exists to guard, and passing because of it.
  -->
  <PropertyGroup Condition="'$(GraphicsBackend)' == 'GL'">
    <DefineConstants>$(DefineConstants);MONOGAME_DESKTOPGL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CutTheRopeDX.Core\CutTheRopeDX.Core.csproj" />
    <ProjectReference Include="..\CutTheRopeDX.Launcher\CutTheRopeDX.Launcher.csproj" />
  </ItemGroup>

  <!--
    The ring is a binary contract the browser thread writes and the owner thread
    reads. It depends on nothing browser-specific, so it is linked in rather than
    referenced: the Browser head targets net10.0-browser, which this project cannot
    reference, and a contract this easy to get subtly wrong should not go untested.
  -->
  <ItemGroup>
    <Compile Include="../CutTheRopeDX.Browser/Browser/HostEventRing.cs"
             Link="Browser/HostEventRing.cs" />
    <Compile Include="../CutTheRopeDX.Browser/Browser/ContentCache.cs"
             Link="Browser/ContentCache.cs" />
    <Compile Include="../CutTheRopeDX.Browser/Browser/ParallelPump.cs"
             Link="Browser/ParallelPump.cs" />
  </ItemGroup>

  <!--
    The headless tests read the real content tree from their own output directory: maps, locales,
    the pack lists and image_dimensions.json. All of it is checked in, so the data files are copied
    straight from the source tree — running the tests needs no content build, no asset download and
    no ffmpeg, and none of the textures, audio or video those would produce.
  -->
  <ItemGroup>
    <None Include="../../content/**/*.json;../../content/**/*.xml" Exclude="../../content/Builder/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>content/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="Baselines/**/*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
